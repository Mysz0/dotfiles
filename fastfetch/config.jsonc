{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
        "separator": "  ",
        "key": {
            "width": 10
        }
    },
    "modules": [
        "break",
        {
            "type": "os",
            "key": "os"
        },
        {
            "type": "wm",
            "key": "de"
        },
        {
            "type": "packages",
            "key": "pkgs",
            "format": "{1}",
            "manager": "pacman"
        },
        {
            "type": "shell",
            "key": "shell"
        },
        {
            "type": "kernel",
            "key": "kernel"
        },
        {
            "type": "uptime",
            "key": "uptime"
        },
        {
            "type": "command",
            "key": "os age",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); echo $(((current - birth_install) / 86400)) days"
        },
        {
            "type": "memory",
            "key": "memory"
        },
        {
            "type": "disk",
            "key": "disk"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
