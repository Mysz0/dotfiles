/*****----- Load Colors & Fonts -----*****/
@import '~/.config/rofi/colors.rasi'

* {
    font: "JetBrainsMono Nerd Font 11";
}

/*****----- Configuration -----*****/
configuration {
    modi:                        "drun,run,filebrowser,window";
    show-icons:                  true;
    display-drun:                " ";
    display-run:                 " ";
    display-filebrowser:         " ";
    display-window:              " ";
    drun-display-format:         "{name}";
    window-format:               "{w} · {c} · {t}";
}

/*****----- Main Window -----*****/
window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       600px;
    x-offset:                    0px;
    y-offset:                    0px;

    enabled:                     true;
    fixed-height:                false;
    border-radius:               15px;
    border:                      2px solid;
    border-color:                @primary;
    cursor:                      "default";
    background-color:            @surface-alpha; 
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     0px;
    background-color:            transparent;
    orientation:                 vertical;
    children:                    [ "inputbar", "listbox" ];
}

listbox {
    spacing:                     10px;
    padding:                     10px;
    background-color:            transparent;
    orientation:                 vertical;
    children:                    [ "message", "listview" ];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                     true;
    expand:                      false;
    margin:                      20px;
    padding:                     5px;
    border-radius:               12px;
    background-color:            transparent;
    text-color:                  @on-surface;
    children:                    [ "textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
    str:                         " ";
    expand:                      false;
    padding:                     0 1% 0;
    horizontal-align:            0.5;
    vertical-align:              0.5;
    border-radius:               12px;
    background-color:            @primary;
    text-color:                  @surface;
    font:                        "JetBrainsMono Nerd Font 14";
}

entry {
    expand:                      true;
    padding:                     14px;
    placeholder:                 "Search";
    border-radius:               12px;
    background-color:            @surface;
    text-color:                  @on-surface;
}

/*****----- Listview -----*****/
listview {
    enabled:                     true;
    fixed-height:                false;
    columns:                     1;
    lines:                       7;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-columns:               true;
    padding:                     10px 20px;
    spacing:                     5px;
    background-color:            transparent;
    text-color:                  @on-surface;
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
    spacing:                     10px;
    padding:                     8px;
    border-radius:               8px;
    background-color:            transparent;
    text-color:                  @on-surface;
    cursor:                      pointer;
}

element selected.normal {
    background-color:            @primary-fixed;
    text-color:                  @surface;
}

element-icon {
    background-color:            transparent;
    size:                        32px;
    cursor:                      inherit;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    vertical-align:              0.5;
}
